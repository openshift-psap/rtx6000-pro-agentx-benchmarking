# Copy to config/run.env and edit. Paths may be absolute or relative to the repository root.
RUN_ID=agentx-example-$(date -u +%Y%m%dT%H%M%SZ)
NAMESPACE=benchmark
MODEL_ID=nvidia/Qwen3.8-27B-NVFP4
RUNTIME_IMAGE=registry.redhat.io/rhaii-fast/vllm-cuda-rhel9:1789484859
DEPLOYMENT_PROFILE=rhaiis-raw-vllm
BENCHMARK_PROFILE=aiperf-agentx-inference
EXPECTED_DURATION_SECONDS=1800
BENCHFLOW_REPO=../benchflow
BENCHFLOW_COMMIT=854804914535d1df127d9825eb92fa2056eff71f
TARGET_URL=https://model.example
TARGET_PATH=/v1/models
TP_SIZE=2
REPLICAS=4
MATRIX_FILE=config/matrix-agentx.example.tsv
OUTPUT_ROOT=runs
NO_RHOAI_AUTH=true
NO_MLFLOW=true
DISABLE_AIPERF_SERVER_METRICS=true
AIPERF_HTTP_SSL_VERIFY=true
